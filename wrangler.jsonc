// SPDX-License-Identifier: AGPL-3.0-only
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "advocatra",
  "main": "apps/web/src/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "local", "APP_DOMAIN": "advocatra.com", "APP_SUFFIX": "" },
  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "Vault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault"] }],
  "env": {
    "dev": {
      "name": "advocatra-dev",
      "vars": {
        "ENVIRONMENT": "dev",
        "APP_ORIGIN": "https://dev.advocatra.com",
        "APP_DOMAIN": "advocatra.com",
        "APP_SUFFIX": "-dev",
        // Test-mode prices under the arleyxu financial services Stripe
        // account (same account Saldima uses) — "Advocatra Monthly
        // Subscription" ($20/mo) and "Advocatra Annual Subscription"
        // ($200/yr). Not secrets; committed the same way Saldima commits
        // its own price ids. STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET
        // are wrangler secrets, never committed here.
        "STRIPE_PRICE_MONTHLY": "price_1UgHVPDB7RpIiDnc3l1E294Q",
        "STRIPE_PRICE_YEARLY": "price_1UgHV1DB7RpIiDncn3RCBcno"
      },
      "workers_dev": false,
      "routes": [
        { "pattern": "dev.advocatra.com", "custom_domain": true },
        // Wildcard DNS record (*-dev.advocatra.com, proxied) created on the
        // zone; per-tenant vanity dev subdomains route through this pattern.
        { "pattern": "*-dev.advocatra.com/*", "zone_name": "advocatra.com" }
      ],
      "kv_namespaces": [{ "binding": "KV", "id": "f244c0a60bbf4755aa45c7a627350ff1" }],
      "r2_buckets": [{ "binding": "R2", "bucket_name": "advocatra-dev-snapshots" }],
      "durable_objects": {
        "bindings": [{ "name": "VAULT", "class_name": "Vault" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault"] }]
    },
    "staging": {
      "name": "advocatra-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_ORIGIN": "https://stage.advocatra.com",
        "APP_DOMAIN": "advocatra.com",
        "APP_SUFFIX": "-stage"
      },
      "workers_dev": false,
      "routes": [
        { "pattern": "stage.advocatra.com", "custom_domain": true },
        { "pattern": "*-stage.advocatra.com/*", "zone_name": "advocatra.com" }
      ],
      "kv_namespaces": [{ "binding": "KV", "id": "07637ea1cecc461183300d801424f56a" }],
      "r2_buckets": [{ "binding": "R2", "bucket_name": "advocatra-staging-snapshots" }],
      "durable_objects": {
        "bindings": [{ "name": "VAULT", "class_name": "Vault" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault"] }]
    },
    "production": {
      "name": "advocatra-production",
      "vars": {
        "ENVIRONMENT": "production",
        "APP_ORIGIN": "https://advocatra.com",
        "APP_DOMAIN": "advocatra.com",
        "APP_SUFFIX": ""
      },
      "routes": [
        { "pattern": "advocatra.com", "custom_domain": true },
        { "pattern": "*.advocatra.com/*", "zone_name": "advocatra.com" }
      ],
      "kv_namespaces": [{ "binding": "KV", "id": "REPLACE_WITH_PRODUCTION_KV_ID" }],
      "r2_buckets": [
        { "binding": "R2", "bucket_name": "advocatra-production-snapshots" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "VAULT", "class_name": "Vault" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault"] }]
    }
  }
}
